# Postgres connection (provided automatically by Railway when you attach the add-on)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI API key for the optional "Rewrite as narrative" toggle
OPENAI_API_KEY=sk-...

# Optional: model to use for narrative rewrite (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
